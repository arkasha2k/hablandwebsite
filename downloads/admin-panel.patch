@@ -0,0 +1,81 @@
+<?php
+
+namespace App\Models;
+
+use Carbon\Carbon;
+use Illuminate\Database\Eloquent\Model;
+
+/**
+ * 🆕 Действия администраторов (CMS-лог).
+ */
+class ActivityLog extends Model
+{
+    protected $table = 'activity_logs';
+    public $timestamps = false;
+
+    protected $fillable = [
+        'user_id', 'action', 'description', 'target_type', 'target_id', 'ip', 'created_at_int',
+    ];
+
+    /** Кто сделал запись */
+    public function user()
+    {
+        return $this->belongsTo(User::class);
+    }
+
+    protected static function booted(): void
+    {
+        static::creating(function (ActivityLog $log) {
+            if (empty($log->created_at_int)) {
+                $log->created_at_int = time();
+            }
+        });
+    }
+
+    public function getCreatedAtIntAttribute($value): ?Carbon
+    {
+        return $value ? Carbon::createFromTimestamp((int) $value) : null;
+    }
+
+    /** Иконка + метка для типа действия */
+    public function getActionLabelAttribute(): string
+    {
+        return match (true) {
+            str_starts_with($this->action, 'news.create') => '📰 Новость создана',
+            str_starts_with($this->action, 'news.update') => '✏️ Новость изменена',
+            str_starts_with($this->action, 'news.delete') => '🗑 Новость удалена',
+            str_starts_with($this->action, 'user.ban')   => '🔨 Бан выдан',
+            str_starts_with($this->action, 'user.unban') => '✅ Бан снят',
+            str_starts_with($this->action, 'user.rank')  => '🎖 Смена ранга',
+            str_starts_with($this->action, 'user.edit')  => '📝 Профиль изменён',
+            default => $this->action,
+        };
+    }
+
+    /** Цвет бейджа по категории действия */
+    public function getActionColorAttribute(): string
+    {
+        return match (true) {
+            str_starts_with($this->action, 'news')  => 'cyan',
+            str_contains($this->action, 'ban')      => 'rose',
+            str_contains($this->action, 'rank')     => 'fuchsia',
+            default                                => 'violet',
+        };
+    }
+
+    /**
+     * Записать действие в лог. Вызывается из админ-контроллеров.
+     */
+    public static function record(string $action, string $description,
+                                  ?string $targetType = null, ?int $targetId = null): static
+    {
+        return static::create([
+            'user_id'     => auth()->id(),
+            'action'      => $action,
+            'description' => $description,
+            'target_type' => $targetType,
+            'target_id'   => $targetId,
+            'ip'          => request()->ip(),
+        ]);
+    }
+}
diff --git a/app/Models/Ban.php b/app/Models/Ban.php
new file mode 100644
index 0000000..3f3d8e1
--- /dev/null
+++ b/app/Models/Ban.php
@@ -0,0 +1,80 @@
+<?php
+
+namespace App\Models;
+
+use Carbon\Carbon;
+use Illuminate\Database\Eloquent\Model;
+
+/**
+ * 🆕 Читаемо-записываемая модель таблицы bans эмулятора.
+ * Таблица лежит в той же БД, что и users (проверено на вашем дампе),
+ * поэтому Laravel работает с ней напрямую через Eloquent.
+ */
+class Ban extends Model
+{
+    protected $table = 'bans';
+    public $timestamps = false;
+    protected $primaryKey = 'id';
+    protected $keyType = 'int';
+    public $incrementing = true;
+
+    protected $fillable = [
+        'user_id', 'ip', 'machine_id', 'user_staff_id',
+        'timestamp', 'ban_expire', 'ban_reason', 'type', 'cfh_topic',
+    ];
+
+    protected function casts(): array
+    {
+        return [
+            'user_id'       => 'integer',
+            'user_staff_id' => 'integer',
+            'timestamp'     => 'integer',
+            'ban_expire'    => 'integer',
+            'cfh_topic'     => 'integer',
+        ];
+    }
+
+    /** Бан всё ещё активен? (ban_expire = 0 означает бессрочный) */
+    public function isActive(): bool
+    {
+        return $this->ban_expire === 0 || $this->ban_expire > time();
+    }
+
+    /** То же как атрибут — для Blade ($ban->is_active) */
+    public function getIsActiveAttribute(): bool
+    {
+        return $this->isActive();
+    }
+
+    public function getExpiresAtAttribute(): ?Carbon
+    {
+        return $this->ban_expire > 0 ? Carbon::createFromTimestamp($this->ban_expire) : null;
+    }
+
+    /** Кто забанил */
+    public function staff()
+    {
+        return $this->belongsTo(User::class, 'user_staff_id');
+    }
+
+    /** Кого забанили */
+    public function user()
+    {
+        return $this->belongsTo(User::class, 'user_id');
+    }
+
+    public function getTypeLabelAttribute(): string
+    {
+        return match ($this->type) {
+            'ip'      => 'По IP',
+            'machine' => 'По железу',
+            'super'   => 'SUPER (акк + IP + железо)',
+            default   => 'Аккаунт',
+        };
+    }
+
+    public function scopeActive($q)
+    {
+        return $q->where(fn ($w) => $w->where('ban_expire', 0)->orWhere('ban_expire', '>', time()));
+    }
+}
